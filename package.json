{
  "name": "dsh-claude-usage",
  "version": "0.2.1",
  "description": "Remaining five-hour and weekly Claude usage for dsh-claude-provider.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "ObnubiladO",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js && node --check lib/usage.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.6 <0.3.0",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "react": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObnubiladO/dsh-claude-usage.git"
  },
  "homepage": "https://github.com/ObnubiladO/dsh-claude-usage#readme",
  "bugs": {
    "url": "https://github.com/ObnubiladO/dsh-claude-usage/issues"
  }
}
